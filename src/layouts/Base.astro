---
import "@fontsource-variable/instrument-sans/wdth.css";
import "@fontsource/big-shoulders-display/900";
import "../styles/global.css";
import fuentePrincipal from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";
import Medicion from "../components/Medicion.astro";
import { negocio } from "../lib/negocio";

interface Props { titulo: string; descripcion: string; schema?: object }
const { titulo, descripcion, schema } = Astro.props;
const site = Astro.site!;
const canonica = new URL(Astro.url.pathname.replace(/index(\.html)?$/, ""), site).href;
const imagen = new URL("/og-body-people.jpg", site).href;
const altImagen = `${negocio.nombre}: ${negocio.entrenador.nombre} y el gimnasio en el Amarilo, Villavicencio`;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#d10f2a" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={fuentePrincipal} as="font" type="font/woff2" crossorigin />
    {negocio.medicion.search_console && <meta name="google-site-verification" content={negocio.medicion.search_console} />}

    <!-- Al compartir el enlace (WhatsApp, Facebook, Instagram) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altImagen} />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <slot />
    <Medicion />
  </body>
</html>
